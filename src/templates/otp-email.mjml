<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f5">
    <mj-section padding="32px 0 16px">
      <mj-column>
        <mj-text align="center" font-size="20px" font-weight="700" color="#111111">
          BookMyEvent
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border-radius="12px" padding="32px">
      <mj-section padding="0">
        <mj-column>
          <mj-text font-size="18px" font-weight="600" color="#111111">
            Hi {{name}},
          </mj-text>
          <mj-text font-size="14px" color="#444444" line-height="22px">
            We received a request to reset your password. Use the code below to continue. This
            code expires in {{expiryMinutes}} minutes.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="16px 0">
        <mj-column background-color="#f4f4f5" border-radius="8px" padding="16px">
          <mj-text
            align="center"
            font-size="32px"
            font-weight="700"
            letter-spacing="8px"
            color="#111111"
          >
            {{otp}}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0">
        <mj-column>
          <mj-text font-size="13px" color="#888888" line-height="20px">
            If you did not request a password reset, you can safely ignore this email — your
            password will not be changed.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="16px 0 32px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#999999">
          © {{year}} BookMyEvent. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
