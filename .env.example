PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5544/event_booking?schema=public"

CLIENT_URL=http://localhost:5175

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

REDIS_URL=redis://localhost:6390

# Local dev defaults point at the Mailpit container from docker-compose.yml.
# For production, point these at a real SMTP provider (e.g. Brevo).
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BookMyEvent <no-reply@bookmyevent.test>"

OTP_TTL_SECONDS=600
OTP_MAX_VERIFY_ATTEMPTS=5

# How long a seat hold stays exclusive before it's released automatically.
HOLD_TTL_SECONDS=300

# Stripe test-mode keys. STRIPE_WEBHOOK_SECRET is printed by
# `stripe listen --forward-to localhost:4000/webhooks/stripe` for local dev,
# or comes from the webhook endpoint's settings in the Stripe dashboard.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Platform commission (basis points of gross) kept on every booking; 500 = 5%.
STRIPE_CONNECT_PLATFORM_FEE_BPS=500
# Where Stripe's hosted Express onboarding sends the organiser back to.
STRIPE_CONNECT_ONBOARDING_RETURN_URL=http://localhost:5175/organizer/wallet?onboarding=return
STRIPE_CONNECT_ONBOARDING_REFRESH_URL=http://localhost:5175/organizer/wallet?onboarding=refresh

# Where "Redis is down" / support-ticket alerts are emailed.
SUPPORT_ALERT_EMAIL=support@bookmyevent.test
